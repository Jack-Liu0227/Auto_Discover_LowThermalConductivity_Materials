# ASLK environment template
# Copy this file to `.env` and fill in your own provider settings.

# LLM provider configuration
WORKFLOW_MODEL=YOUR_MODEL_NAME
WORKFLOW_API_KEY=YOUR_API_KEY
WORKFLOW_BASE_URL=YOUR_BASE_URL

THEORY_UPDATE_MODEL=YOUR_MODEL_NAME
THEORY_UPDATE_API_KEY=YOUR_API_KEY
THEORY_UPDATE_BASE_URL=YOUR_BASE_URL

TEMPERATURE=0.3

# Materials database
MP_API_KEY=YOUR_MP_API_KEY

# Optional endpoint override
AFLOW_BASE_URL=YOUR_BASE_URL
